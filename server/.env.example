# 복사해서 사용: cp .env.example .env.local
# 실제 값이 들어간 .env* 파일은 절대 커밋하지 않는다. (.gitignore 처리됨)

# local | production | test
NODE_ENV=local
PORT=3000

# 허용할 프론트 주소. 쉼표로 여러 개. 로컬은 * 허용.
# 운영 예: https://your-app.vercel.app
CORS_ORIGINS=*

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=hackathon

# true면 서버 시작 시 drizzle/ 폴더의 마이그레이션을 DB에 적용한다. 운영에서 true.
# 로컬은 pnpm db:migrate 를 직접 실행하므로 false.
DB_MIGRATE_ON_START=false
DB_LOGGING=true

# --- YouTube 수집기 (pnpm collect:youtube). 서버 실행에는 필요 없다. ---
# Google Cloud 에서 발급한 YouTube Data API 키. search.list 는 하루 100회까지다.
# YOUTUBE_API_KEY=
# 수집 결과를 보낼 서버 API 주소와 내부 API 토큰(X-Seed-Token). --dry-run --channels-file 로 실측할 때는 없어도 된다.
# SYNC_API_BASE_URL=http://localhost:3000/api
# SEED_TOKEN=
# 채널당 유지할 활성 영상 수
# TARGET_PER_CHANNEL=100
# search.list 호출 상한: 한 번 실행 전체, 채널 하나당 (페이지 넘김 포함)
# SEARCH_CALL_BUDGET=60
# SEARCH_CALLS_PER_CHANNEL=6
# 저장할 영상 길이(초). 기본 10분 ~ 2시간
# MIN_DURATION_SECONDS=600
# MAX_DURATION_SECONDS=7200
